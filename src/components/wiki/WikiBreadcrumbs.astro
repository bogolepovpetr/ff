---
import { Icon } from "astro-icon/components";

export type Crumb = { href?: string; label: string };

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground">
  {crumbs.map((c, i) => (
    <span class="inline-flex items-center gap-1">
      {i > 0 ? <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" /> : null}
      {c.href ? (
        <a href={c.href} class="wiki-link hover:underline">{c.label}</a>
      ) : (
        <span class="font-medium text-foreground">{c.label}</span>
      )}
    </span>
  ))}
</nav>
