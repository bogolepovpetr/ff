---
import { WIKI_DISPLAY_NAME, GAME_DISPLAY_NAME } from "@/lib/site-brand";
import { localizedPath } from "@/lib/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const ru = lang === "ru";

const PLAY_URL = "https://play.fomofighters.xyz";
const TELEGRAM_URL = "https://t.me/fomo_fighters";

const tagline = ru
  ? `Полное руководство по игре ${GAME_DISPLAY_NAME}`
  : `The comprehensive guide to ${GAME_DISPLAY_NAME}`;

const copyright = ru
  ? `${WIKI_DISPLAY_NAME} © ${new Date().getFullYear()} — данные игры обновляются автоматически с сервера баланса.`
  : `${WIKI_DISPLAY_NAME} © ${new Date().getFullYear()} — Game data updates automatically from the balance server.`;
---

<footer class="relative overflow-hidden border-t-4 border-[var(--game-frame)] bg-[#2b1f17] py-10 text-[#f4ecd9]">
  <div
    class="pointer-events-none absolute inset-0 bg-[url('/img/decor/bg/paper.jpg')] bg-cover bg-center opacity-[0.03]"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <a href={localizedPath("/", lang)} class="font-heading text-lg font-bold uppercase tracking-wide text-[var(--game-atk)] transition-opacity hover:opacity-85">
          {WIKI_DISPLAY_NAME}
        </a>
        <p class="mt-1.5 text-sm text-[#b6a888]">{tagline}</p>
      </div>

      <nav class="flex items-center gap-6" aria-label="Links">
        <a
          href={PLAY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-bold uppercase tracking-wide text-[#f4ecd9] transition-colors hover:text-[var(--game-atk)]"
        >
          {ru ? "Играть" : "Play"}
        </a>
        <a
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-bold uppercase tracking-wide text-[#f4ecd9] transition-colors hover:text-[var(--game-atk)]"
        >
          Telegram
        </a>
      </nav>
    </div>

    <p class="mt-10 border-t border-white/10 pt-5 text-center text-xs text-[#b6a888]">
      {copyright}
    </p>
  </div>
</footer>
