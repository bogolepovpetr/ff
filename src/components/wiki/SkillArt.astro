---
import { skillImage } from "@/lib/images";

interface Props {
  lang: string;
  skillKey: string;
  skillTitle: string;
  fallbackIconKey?: string;
}

const { lang, skillKey, skillTitle, fallbackIconKey } = Astro.props;
const fallbackSvg = fallbackIconKey ? `/img/icon/${fallbackIconKey}.svg` : "/img/icon/book_timer.svg";
---

<div class="flex h-56 w-56 items-center justify-center rounded-lg bg-zinc-50 ring-1 ring-zinc-100">
  <img
    src={skillImage(skillKey)}
    alt={skillTitle}
    class="h-56 w-56 rounded-lg object-cover"
    onerror="this.style.display='none'; var n=this.nextElementSibling; if(n) n.style.display='block';"
  />
  <img
    src={fallbackSvg}
    alt={lang === "ru" ? "Иконка навыка" : "Skill icon"}
    class="hidden h-24 w-24 opacity-90"
    onerror="this.style.display='none';"
  />
</div>
