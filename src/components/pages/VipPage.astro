---
import { Icon } from "astro-icon/components";
import { getVipPassLevels, getVipTimePacks, getVipWiki } from "@/lib/data";
import { extractVipNewPerms, extractVipNewUnlocks, formatCost } from "@/lib/format";
import ResourceIcon from "@/components/wiki/ResourceIcon.astro";
import WikiBreadcrumbs from "@/components/wiki/WikiBreadcrumbs.astro";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const ru = lang === "ru";
const wiki = getVipWiki();
const allLevels = getVipPassLevels();
const levels = allLevels.filter((l) => l.lvl > 0);
const maxLevel = Math.max(...levels.map((l) => l.lvl));
const packs = getVipTimePacks();

function fmtNumber(n: number): string {
  return new Intl.NumberFormat("en-US").format(n);
}

function durationLabel(days: number): string {
  if (days === 1) return ru ? "24 часа" : "24 hours";
  if (days === 7) return ru ? "7 дней" : "7 days";
  if (days === 30) return ru ? "30 дней" : "30 days";
  return ru ? `${days} дн.` : `${days} days`;
}
---

<div class="space-y-6">
  <WikiBreadcrumbs
    crumbs={[
      { href: localizedPath("/", lang), label: ru ? "Главная" : "Home" },
      { label: "VIP" },
    ]}
  />

  <div class="wiki-hero">
    <h1 class="flex items-center gap-2 text-2xl font-bold">
      <Icon name="lucide:crown" class="h-6 w-6 text-[var(--game-orange)]" />
      VIP
    </h1>
    <p class="mt-2 text-sm leading-relaxed opacity-90">{ru ? wiki.intro_ru : wiki.intro_en}</p>
    <ul class="mt-4 space-y-1.5 text-sm opacity-90">
      {(ru ? wiki.bullets_ru : wiki.bullets_en).map((b) => (
        <li class="flex gap-2">
          <span class="text-[var(--game-orange)]">•</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>
    <div class="mt-4 flex flex-wrap gap-2">
      <span class="wiki-chip wiki-chip-accent">
        <Icon name="lucide:crown" class="h-3.5 w-3.5" />
        {ru ? "Макс. уровень" : "Max level"}: {maxLevel}
      </span>
      <a href={localizedPath("/vip/streak", lang)} class="wiki-chip">
        <Icon name="lucide:flame" class="h-3.5 w-3.5 text-[var(--game-atk)]" />
        {ru ? "Стрик сундука" : "Chest streak"}
      </a>
    </div>
  </div>

  <section class="wiki-panel">
    <div class="border-b border-[var(--game-frame)] px-5 py-4">
      <h2 class="flex items-center gap-2 text-lg font-bold">
        <Icon name="lucide:clock" class="h-5 w-5 text-[var(--game-green)]" />
        {ru ? "VIP-время" : "VIP time"}
      </h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        {ru
          ? "Покупка продлевает vip_expires_at. Пока VIP-время активно — работают все привилегии текущего VIP-уровня."
          : "Purchase extends vip_expires_at. While VIP time is active, all perks of your current VIP level apply."}
      </p>
    </div>

    <div class="grid gap-4 p-5 sm:grid-cols-3">
      {packs.map((p) => (
        <div class="rounded-xl border border-[var(--game-frame)] bg-[var(--game-bg)] p-4 text-center">
          <p class="text-lg font-bold">{durationLabel(p.days)}</p>
          <p class="mt-2 inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-[var(--game-orange)]">
            <ResourceIcon res="gem" class="h-4 w-4" />
            {fmtNumber(p.gem_cost)}
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="wiki-panel">
    <div class="border-b border-[var(--game-frame)] px-5 py-4">
      <h2 class="flex items-center gap-2 text-lg font-bold">
        <Icon name="lucide:trophy" class="h-5 w-5 text-[var(--game-orange)]" />
        {ru ? "VIP-уровни" : "VIP levels"}
      </h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        {ru
          ? "На каждом уровне показаны новые пассивные бонусы и разблокировки. Итоговые значения бонусов — абсолютные для текущего уровня."
          : "Each level shows newly unlocked passive bonuses and features. Total bonus values are absolute for that level."}
      </p>
    </div>

    <div class="overflow-auto">
      <table class="w-full min-w-[800px] text-sm">
        <thead>
          <tr class="border-b border-[var(--game-frame)] bg-[var(--game-bg)] text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
            <th class="px-4 py-2">{ru ? "Уровень" : "Level"}</th>
            <th class="px-4 py-2">{ru ? "VIP-очки" : "VIP points"}</th>
            <th class="px-4 py-2">{ru ? "Новые пассивные бонусы" : "New passive bonuses"}</th>
            <th class="px-4 py-2">{ru ? "Разблокировки" : "Unlocks"}</th>
          </tr>
        </thead>
        <tbody>
          {levels.map((l, i) => {
            const prev = allLevels.find((x) => x.lvl === l.lvl - 1) ?? null;
            const unlocks = extractVipNewUnlocks(l, prev, lang);
            const perms = extractVipNewPerms(l, prev, lang);
            const skinNew =
              l.skinKey && l.skinKey !== (prev as { skinKey?: string } | null)?.skinKey
                ? [ru ? "VIP-скин города" : "VIP city skin"]
                : [];
            const allPerms = [...perms, ...skinNew];

            return (
              <tr class={`border-b border-[var(--game-frame)]/50 align-top ${i % 2 === 1 ? "bg-[var(--game-bg)]/40" : ""}`}>
                <td class="px-4 py-3 font-semibold">{l.title}</td>
                <td class="px-4 py-3">{formatCost(l.gem_cost)}</td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1.5">
                    {unlocks.length === 0 ? (
                      <span class="text-muted-foreground">—</span>
                    ) : (
                      unlocks.map((u) => (
                        <span class={u.kind === "new" ? "wiki-unlock-new" : "wiki-unlock-up"}>
                          {u.kind === "new" ? "+" : "↑"} {u.label}
                          {u.kind === "upgrade" && u.prevValue !== undefined ? `: ${u.prevValue} → ${u.value}` : `: ${u.value}`}
                        </span>
                      ))
                    )}
                  </div>
                </td>
                <td class="px-4 py-3 text-xs">
                  {allPerms.length === 0 ? (
                    <span class="text-muted-foreground">—</span>
                  ) : (
                    <div class="flex flex-wrap gap-1">
                      {allPerms.map((p) => (
                        <span class="wiki-unlock-new">+ {p}</span>
                      ))}
                    </div>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
</div>
