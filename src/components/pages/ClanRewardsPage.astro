---
import { Icon } from "astro-icon/components";
import { getClanRewards } from "@/lib/data";
import RewardBits from "@/components/wiki/RewardBits.astro";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const ru = lang === "ru";
const rewards = getClanRewards().slice().sort((a, b) => a.level - b.level);

function fmtTitle(title: string, hours: number): string {
  const base = ru ? "Награда каждые {count} часов" : "Reward every {count} hours";
  const tpl = title?.includes("{count}") ? title : base;
  return tpl.replaceAll("{count}", String(hours));
}
---

<div class="space-y-6">
  <nav class="flex items-center gap-1 text-sm text-zinc-500">
    <a href={localizedPath("/clans", lang)} class="hover:text-amber-700 hover:underline">{ru ? "Кланы" : "Clans"}</a>
    <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
    <span class="font-medium text-zinc-700">{ru ? "Награды клана" : "Clan rewards"}</span>
  </nav>

  <section class="rounded-xl border border-zinc-200 bg-white">
    <div class="border-b border-zinc-100 px-5 py-4">
      <h1 class="flex items-center gap-2 text-2xl font-bold text-slate-900">
        <Icon name="lucide:gift" class="h-6 w-6 text-emerald-600" />
        {ru ? "Награды клана" : "Clan rewards"}
      </h1>
      <p class="mt-2 max-w-3xl text-sm text-zinc-600">
        {ru
          ? "Чем выше уровень клана, тем больше доступно наград. Награды выдаются с определённым интервалом (в часах)."
          : "Higher clan level unlocks more rewards. Rewards are available on a timed interval (hours)."}
      </p>
    </div>

    <div class="overflow-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wider text-zinc-500">
            <th class="px-4 py-2">{ru ? "Уровень" : "Level"}</th>
            <th class="px-4 py-2">{ru ? "Интервал" : "Interval"}</th>
            <th class="px-4 py-2">{ru ? "Награда" : "Reward"}</th>
          </tr>
        </thead>
        <tbody>
          {rewards.map((r, i) => (
            <tr class={`border-b border-zinc-100 ${i % 2 === 1 ? "bg-zinc-50/50" : ""}`}>
              <td class="px-4 py-2 font-semibold text-zinc-800">Lv {r.level}</td>
              <td class="px-4 py-2 text-zinc-700">{fmtTitle(r.title, r.hours)}</td>
              <td class="px-4 py-2 text-zinc-700">
                <RewardBits food={r.food} wood={r.wood} stone={r.stone} gem={r.gem} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>
