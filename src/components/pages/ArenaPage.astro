---
import { Icon } from "astro-icon/components";
import { getArenaPvpTiers, getArenaWiki } from "@/lib/data";
import { formatCost, leagueLabel } from "@/lib/format";
import RewardDict from "@/components/wiki/RewardDict.astro";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const ru = lang === "ru";
const wiki = getArenaWiki();
const tiers = getArenaPvpTiers();

const floorLabel = (min: number, max: number) => (min === max ? `Lv ${min}` : `Lv ${min}–${max}`);
---

<div class="space-y-6">
  <nav class="flex items-center gap-1 text-sm text-zinc-500">
    <a href={localizedPath("/", lang)} class="hover:text-amber-700 hover:underline">{ru ? "Главная" : "Home"}</a>
    <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
    <span class="font-medium text-zinc-700">{ru ? wiki.title_ru : wiki.title_en}</span>
  </nav>

  <div class="wiki-hero p-6">
    <h1 class="flex items-center gap-2 text-2xl font-bold text-slate-900">
      <Icon name="lucide:swords" class="h-6 w-6 text-rose-600" />
      {ru ? wiki.title_ru : wiki.title_en}
    </h1>
    <p class="mt-2 text-sm leading-relaxed text-zinc-600">{ru ? wiki.intro_ru : wiki.intro_en}</p>
    <ul class="mt-4 space-y-1.5 text-sm text-zinc-600">
      {(ru ? wiki.bullets_ru : wiki.bullets_en).map((b) => (
        <li class="flex gap-2">
          <span class="text-rose-500">•</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>
    <a href={localizedPath("/buildings/arena", lang)} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-rose-700 hover:text-rose-600">
      <Icon name="lucide:castle" class="h-4 w-4" />
      {ru ? "Здание: Арена" : "Building: Arena"}
    </a>
  </div>

  <section class="rounded-xl border border-zinc-200 bg-white">
    <div class="border-b border-zinc-100 px-5 py-4">
      <h2 class="text-lg font-bold text-slate-800">{ru ? "Этажи и награды" : "Floors and rewards"}</h2>
      <p class="mt-1 text-xs text-zinc-500">
        {ru ? "Минимум Kill Points для получения наград — requiredKillPoints." : "Minimum Kill Points to qualify for rewards — requiredKillPoints."}
      </p>
    </div>

    <div class="overflow-auto">
      <table class="w-full min-w-[960px] text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wider text-zinc-500">
            <th class="px-3 py-2">{ru ? "Этаж" : "Floor"}</th>
            <th class="px-3 py-2">{ru ? "Лига" : "League"}</th>
            <th class="px-3 py-2">KP min</th>
            <th class="px-3 py-2">Top 1</th>
            <th class="px-3 py-2">Top 5</th>
            <th class="px-3 py-2">Top 10</th>
            <th class="px-3 py-2">Top 100</th>
          </tr>
        </thead>
        <tbody>
          {tiers.map((t, i) => (
            <tr class={`border-b border-zinc-100 align-top ${i % 2 === 1 ? "bg-zinc-50/50" : ""}`}>
              <td class="px-3 py-2 font-semibold text-zinc-800">{floorLabel(t.minLevel, t.maxLevel)}</td>
              <td class="px-3 py-2 text-zinc-700">{leagueLabel(t.league, lang)}</td>
              <td class="px-3 py-2 text-zinc-700">{formatCost(t.requiredKillPoints)}</td>
              <td class="px-3 py-2"><RewardDict dict={t.top1} lang={lang} /></td>
              <td class="px-3 py-2"><RewardDict dict={t.top5} lang={lang} /></td>
              <td class="px-3 py-2"><RewardDict dict={t.top10} lang={lang} /></td>
              <td class="px-3 py-2"><RewardDict dict={t.top100} lang={lang} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>
