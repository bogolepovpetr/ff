---
import { Icon } from "astro-icon/components";
import { getPlayableRaces } from "@/lib/data";
import { raceName } from "@/lib/format";
import { localizedPath, useT } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const t = useT(lang);

const RACE_STYLE: Record<string, { img: string; border: string; bg: string; headerBg: string; headerText: string; accent: string }> = {
  elf: { img: "/img/races/race-elf.png", border: "border-emerald-300", bg: "bg-emerald-50", headerBg: "bg-emerald-100", headerText: "text-emerald-900", accent: "text-emerald-700" },
  human: { img: "/img/races/race-human.png", border: "border-sky-300", bg: "bg-sky-50", headerBg: "bg-sky-100", headerText: "text-sky-900", accent: "text-sky-700" },
  demon: { img: "/img/races/race-demon.png", border: "border-rose-300", bg: "bg-rose-50", headerBg: "bg-rose-100", headerText: "text-rose-900", accent: "text-rose-700" },
};

const RACE_SPEC: Record<string, boolean> = {
  elf: true,
  human: true,
  demon: true,
};

const BONUS_LABELS: Record<string, { icon: string }> = {
  energyMax: { icon: "lucide:battery" },
  bonusBuilders: { icon: "lucide:hammer" },
  bonusAcademics: { icon: "lucide:graduation-cap" },
};

const races = getPlayableRaces();

const STAT_ROWS: { key: string }[] = [
  { key: "energyMax" },
  { key: "bonusBuilders" },
  { key: "bonusAcademics" },
];
---

<div class="space-y-8">
  <div class="rounded-xl border border-amber-200 bg-gradient-to-r from-amber-50 to-orange-50 p-6">
    <h1 class="text-2xl font-bold text-slate-900">{t("races.heroTitle")}</h1>
    <p class="mt-1 text-sm font-medium text-amber-700">{t("races.heroSubtitle")}</p>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-600">
      {t("races.heroDesc")}
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-3">
    {races.map((race) => {
      const style = RACE_STYLE[race.key];
      if (!style) return null;
      const bonuses = [
        { key: "energyMax", value: race.energyMax },
        { key: "bonusBuilders", value: race.bonusBuilders },
        { key: "bonusAcademics", value: race.bonusAcademics },
      ];
      return (
        <div class={`overflow-hidden rounded-2xl border-2 ${style.border} ${style.bg} transition-shadow hover:shadow-lg`}>
          <div class={`flex items-center gap-4 ${style.headerBg} px-5 py-4`}>
            <img src={style.img} alt={race.title} class="h-20 w-20 shrink-0 rounded-xl object-contain" />
            <div>
              <h2 class={`text-xl font-bold ${style.headerText}`}>{raceName(race.key, lang)}</h2>
              <p class="mt-1 text-sm leading-snug text-zinc-600">{race.desc}</p>
            </div>
          </div>

          <div class="space-y-2 px-5 py-4">
            <h3 class={`text-xs font-bold uppercase tracking-wider ${style.accent}`}>{t("races.bonusesTitle")}</h3>
            <div class="grid grid-cols-2 gap-2">
              {bonuses.map((b) => {
                const label = BONUS_LABELS[b.key];
                if (!label || b.value == null) return null;
                return (
                  <div class="flex items-center gap-2 rounded-lg bg-white/70 px-3 py-2">
                    <Icon name={label.icon} class={`h-4 w-4 shrink-0 ${style.accent}`} />
                    <div class="min-w-0">
                      <p class="text-[10px] uppercase tracking-wide text-zinc-400">{t(`races.bonusLabel.${b.key}`)}</p>
                      <p class="text-sm font-bold text-slate-800">{b.value}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <div class="border-t border-white/30 px-5 py-3">
            <p class="text-xs text-zinc-500">
              <Icon name="lucide:zap" class="mr-1 inline h-3.5 w-3.5 text-amber-500" />
              {t("races.energyNote")}
            </p>
          </div>

          <div class="border-t border-white/50 px-5 py-3">
            <a href={`${localizedPath("/troops", lang)}?race=${race.key}`} class={`text-sm font-semibold ${style.accent} hover:underline`}>
              {t("races.viewTroopsLink")}
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <section class="rounded-xl border border-zinc-200 bg-white p-6">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-slate-800">
      <Icon name="lucide:swords" class="h-5 w-5 text-amber-500" />
      {t("races.comparisonTitle")}
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wider text-zinc-500">
            <th class="px-4 py-2.5">{t("races.tableStat")}</th>
            {races.map((r) => <th class="px-4 py-2.5 text-center">{raceName(r.key, lang)}</th>)}
          </tr>
        </thead>
        <tbody>
          {STAT_ROWS.map((stat, i) => (
            <tr class={`border-b border-zinc-100 ${i % 2 === 1 ? "bg-zinc-50/50" : ""}`}>
              <td class="px-4 py-2 font-medium text-zinc-700">{t(`races.statLabel.${stat.key}`)}</td>
              {races.map((r) => {
                const val = (r as Record<string, unknown>)[stat.key] as number | undefined;
                const allVals = races.map((rx) => (rx as Record<string, unknown>)[stat.key] as number).filter(Boolean);
                const max = Math.max(...allVals);
                const isMax = val === max && new Set(allVals).size > 1;
                return <td class={`px-4 py-2 text-center ${isMax ? "font-bold text-emerald-700" : "text-zinc-600"}`}>{val ?? "—"}</td>;
              })}
            </tr>
          ))}
          <tr class="border-b border-zinc-100">
            <td class="px-4 py-2 font-medium text-zinc-700">{t("races.energyRegenLabel")}</td>
            {races.map(() => <td class="px-4 py-2 text-center text-zinc-600">{t("races.energyRegenValue")}</td>)}
          </tr>
          <tr class="border-b border-zinc-100">
            <td class="px-4 py-2 font-medium text-zinc-700">{t("races.specializationLabel")}</td>
            {races.map((r) => {
              const hasSpec = RACE_SPEC[r.key];
              return <td class="px-4 py-2 text-center text-zinc-600">{hasSpec ? t(`races.raceSpec.${r.key}`) : "—"}</td>;
            })}
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>
