---
import { Icon } from "astro-icon/components";
import { getClanLevels } from "@/lib/data";
import { localizedPath, useT } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const t = useT(lang);
const levels = getClanLevels();

function fmtNumber(n: number): string {
  return new Intl.NumberFormat("en-US").format(n);
}
---

<div class="space-y-6">
  <nav class="flex items-center gap-1 text-sm text-zinc-500">
    <a href={localizedPath("/clans", lang)} class="hover:text-amber-700 hover:underline">{t("clanLevels.breadcrumbClans")}</a>
    <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
    <span class="font-medium text-zinc-700">{t("clanLevels.title")}</span>
  </nav>

  <section class="rounded-xl border border-zinc-200 bg-white">
    <div class="border-b border-zinc-100 px-5 py-4">
      <h1 class="flex items-center gap-2 text-2xl font-bold text-slate-900">
        <Icon name="lucide:trophy" class="h-6 w-6 text-amber-600" />
        {t("clanLevels.title")}
      </h1>
      <p class="mt-2 max-w-3xl text-sm text-zinc-600">
        {t("clanLevels.heroDesc")}
      </p>
    </div>

    <div class="overflow-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wider text-zinc-500">
            <th class="px-4 py-2">{t("clanLevels.tableLevel")}</th>
            <th class="px-4 py-2">{t("clanLevels.tableExp")}</th>
            <th class="px-4 py-2">{t("clanLevels.tableMembers")}</th>
          </tr>
        </thead>
        <tbody>
          {levels.map((l, i) => (
            <tr class={`border-b border-zinc-100 ${i % 2 === 1 ? "bg-zinc-50/50" : ""}`}>
              <td class="px-4 py-2 font-semibold text-zinc-800">Lv {l.level}</td>
              <td class="px-4 py-2 text-zinc-700">{fmtNumber(l.exp)}</td>
              <td class="px-4 py-2 text-zinc-700">
                <span class="inline-flex items-center gap-1.5">
                  <Icon name="lucide:users" class="h-4 w-4 text-zinc-400" />
                  {fmtNumber(l.members)}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>
