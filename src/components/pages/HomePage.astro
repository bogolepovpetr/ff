---
import { Icon } from "astro-icon/components";
import { getGameVersion } from "@/lib/version";
import PatchBadge from "@/components/wiki/PatchBadge.astro";
import { GAME_DISPLAY_NAME, WIKI_DISPLAY_NAME } from "@/lib/site-brand";
import { localizedPath } from "@/lib/i18n";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const ver = getGameVersion();

const CATEGORIES = [
  { key: "races", iconSrc: "/img/icon/power_troops.svg", en: "Races", ru: "Расы", descEn: "Choose your race: Elf, Human, or Demon", descRu: "Выберите расу: Эльфы, Люди или Демоны", color: "border-orange-300 bg-orange-50 hover:bg-orange-100", iconBg: "bg-orange-200" },
  { key: "buildings", iconSrc: "/img/icon/castle.svg", en: "Buildings", ru: "Здания", descEn: "Construct and upgrade your city structures", descRu: "Стройте и улучшайте сооружения вашего города", color: "border-blue-300 bg-blue-50 hover:bg-blue-100", iconBg: "bg-blue-200" },
  { key: "troops", iconSrc: "/img/icon/atk.svg", en: "Troops", ru: "Войска", descEn: "Train and command your armies", descRu: "Обучайте и командуйте армиями", color: "border-red-300 bg-red-50 hover:bg-red-100", iconBg: "bg-red-200" },
  { key: "skills", iconSrc: "/img/icon/skills.svg", en: "Skills", ru: "Навыки", descEn: "Research technologies in the Academy", descRu: "Исследуйте технологии в Академии", color: "border-violet-300 bg-violet-50 hover:bg-violet-100", iconBg: "bg-violet-200" },
  { key: "heroes", iconSrc: "/img/icon/leads.svg", en: "Heroes", ru: "Герои", descEn: "Legendary commanders to lead your forces", descRu: "Легендарные командиры во главе ваших войск", color: "border-amber-300 bg-amber-50 hover:bg-amber-100", iconBg: "bg-amber-200" },
  { key: "war", iconSrc: "/img/icon/war.svg", en: "WAR", ru: "WAR", descEn: "Seasonal goal: earn $WAR", descRu: "Цель сезона: заработать $WAR", color: "border-emerald-300 bg-emerald-50 hover:bg-emerald-100", iconBg: "bg-emerald-200" },
  { key: "quests", iconSrc: "/img/icon/quests.svg", en: "Daily Quests", ru: "Ежедневные задания", descEn: "Complete objectives for daily rewards", descRu: "Выполняйте задания для получения наград", color: "border-emerald-300 bg-emerald-50 hover:bg-emerald-100", iconBg: "bg-emerald-200" },
  { key: "clans", iconSrc: "/img/icon/clan.svg", en: "Clans", ru: "Кланы", descEn: "Levels, ranks, rewards, and clan war rules", descRu: "Уровни, ранги, награды и правила клановой войны", color: "border-zinc-300 bg-zinc-50 hover:bg-zinc-100", iconBg: "bg-zinc-200" },
  { key: "referral", iconSrc: "/img/icon/friends.svg", en: "Friends", ru: "Друзья", descEn: "Invite friends, earn gems, and get rev share", descRu: "Приглашайте друзей, получайте гемы и rev share", color: "border-sky-300 bg-sky-50 hover:bg-sky-100", iconBg: "bg-sky-200" },
  { key: "deals", iconSrc: "/img/icon/quests_premium.svg", en: "Deals", ru: "Deals", descEn: "VIP perks and Fund of Dawn reward tracks", descRu: "VIP-привилегии и треки наград Fund of Dawn", color: "border-yellow-300 bg-yellow-50 hover:bg-yellow-100", iconBg: "bg-yellow-200" },
  { key: "arena", iconSrc: "/img/icon/rating.svg", en: "Arena PvP", ru: "Арена PvP", descEn: "Kill Points, leagues, and leaderboard rewards", descRu: "Kill Points, лиги и награды рейтинга", color: "border-rose-300 bg-rose-50 hover:bg-rose-100", iconBg: "bg-rose-200" },
  { key: "shop", iconSrc: "/img/icon/shop.svg", en: "Premium Shop", ru: "Премиум магазин", descEn: "Gems, boosts, protection, and premium", descRu: "Гемы, бусты, защита и премиум", color: "border-yellow-300 bg-yellow-50 hover:bg-yellow-100", iconBg: "bg-yellow-200" },
];

const QUICK_LINKS = [
  { href: "/troops/barracks/1", en: "Barracks Troops", ru: "Войска казармы", icon: "🗡️" },
  { href: "/troops/archery_range/1", en: "Archers", ru: "Стрельцы", icon: "🏹" },
  { href: "/troops/stable/1", en: "Cavalry", ru: "Кавалерия", icon: "🐎" },
  { href: "/troops/siege_workshop/1", en: "Siege Units", ru: "Осадные орудия", icon: "💥" },
  { href: "/skills", en: "Skill Tree", ru: "Древо навыков", icon: "🔬" },
  { href: "/heroes", en: "All Heroes", ru: "Все герои", icon: "⚔️" },
];

const GUIDE_STEPS = [
  { step: 1, titleEn: "Build Your Base", titleRu: "Постройте базу", descEn: "Upgrade your Castle and resource buildings to unlock mechanics and speed up progression.", descRu: "Улучшайте Замок и ресурсные здания, чтобы открыть новые механики и ускорить прогресс.", href: "/buildings", linkEn: "Buildings →", linkRu: "Здания →" },
  { step: 2, titleEn: "Build an Army", titleRu: "Соберите армию", descEn: "Train troops and use them in activities—PvE and clan wars are driven by army power.", descRu: "Обучайте войска и отправляйте их в активности — PvE и клановые войны завязаны на силе армии.", href: "/troops", linkEn: "Troops →", linkRu: "Войска →" },
  { step: 3, titleEn: "Upgrade Skills", titleRu: "Прокачайте навыки", descEn: "The Academy unlocks tiers and grants economy/combat bonuses—one of the biggest multipliers.", descRu: "Академия открывает новые тиры и даёт бонусы экономике/бою — это один из главных мультипликаторов.", href: "/skills", linkEn: "Skills →", linkRu: "Навыки →" },
  { step: 4, titleEn: "Join a Clan", titleRu: "Присоединитесь к клану", descEn: "Clans add levels, ranks, rewards, and unlock clan wars with $WAR.", descRu: "Клан даёт уровни, ранги и награды, а также открывает клановую войну с $WAR.", href: "/clans", linkEn: "Clans →", linkRu: "Кланы →" },
  { step: 5, titleEn: "Invite friends", titleRu: "Пригласите друзей", descEn: "Referrals give you rewards for invites and rev share—one of the best gem sources.", descRu: "Реферальная система даёт награды за приглашения и rev share — один из лучших источников гемов.", href: "/referral", linkEn: "Referral →", linkRu: "Рефералы →" },
  { step: 6, titleEn: "Earn WAR points", titleRu: "Зарабатывайте WAR points", descEn: "The main seasonal goal is to accumulate $WAR through clan wars and take part in the buyback.", descRu: "Основная цель сезона — накапливать $WAR через клановые войны и участвовать в buyback.", href: "/war", linkEn: "WAR →", linkRu: "WAR →" },
];
---

<div class="space-y-8">
  <section class="overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-emerald-50/90 via-amber-50/80 to-orange-50/70 shadow-sm">
    <div class="flex flex-col items-center gap-6 px-8 py-12 text-center md:flex-row md:text-left">
      <div class="flex-1">
        <h1 class="text-4xl font-extrabold tracking-tight text-foreground">{WIKI_DISPLAY_NAME}</h1>
        <p class="mt-2 text-lg text-primary">
          {lang === "ru" ? `Полное руководство по игре ${GAME_DISPLAY_NAME}` : `The comprehensive guide to ${GAME_DISPLAY_NAME}`}
        </p>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">
          {lang === "ru"
            ? `Добро пожаловать в вики ${GAME_DISPLAY_NAME}! Здесь вы найдёте полную информацию о зданиях, войсках, навыках и героях. Данные обновляются автоматически при каждом обновлении игрового баланса.`
            : `Welcome to the ${WIKI_DISPLAY_NAME}! Find complete information on buildings, troops, skills, and heroes. Data updates automatically with every game balance patch.`}
        </p>
      </div>
      <div class="hidden shrink-0 md:block">
        <img src="/img/_frog/buildings/castle.png" alt={GAME_DISPLAY_NAME} class="h-32 w-32 rounded-2xl object-cover shadow-lg ring-2 ring-primary/20" />
      </div>
    </div>
  </section>

  <PatchBadge gameVersion={ver.gameVersion} dataUpdated={ver.dataUpdated} lang={lang} />

  <section>
    <h2 class="mb-4 text-xl font-bold text-slate-800">{lang === "ru" ? "Разделы вики" : "Wiki Sections"}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORIES.map((cat) => (
        <a
          href={localizedPath(`/${cat.key}`, lang)}
          class={`group flex items-start gap-4 rounded-xl border-2 p-5 transition-all hover:shadow-md hover:-translate-y-0.5 ${cat.color}`}
        >
          <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl shadow-sm ${cat.iconBg}`}>
            <img src={cat.iconSrc} alt="" class="wiki-section-icon h-7 w-7" />
          </div>
          <div>
            <h3 class="font-bold text-slate-800">{lang === "ru" ? cat.ru : cat.en}</h3>
            <p class="mt-0.5 text-sm text-zinc-600">{lang === "ru" ? cat.descRu : cat.descEn}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="mb-4 text-xl font-bold text-slate-800">{lang === "ru" ? "Быстрые ссылки" : "Quick Links"}</h2>
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {QUICK_LINKS.map((lnk) => (
        <a
          href={localizedPath(lnk.href, lang)}
          class="flex items-center gap-3 rounded-lg border border-zinc-200 bg-white px-4 py-3 text-sm transition-colors hover:border-amber-300 hover:bg-amber-50"
        >
          <span class="text-lg">{lnk.icon}</span>
          <span class="font-medium text-zinc-700">{lang === "ru" ? lnk.ru : lnk.en}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rounded-xl border border-zinc-200 bg-white p-6">
    <h2 class="mb-4 flex items-center gap-2 text-xl font-bold text-slate-800">
      <Icon name="lucide:trophy" class="h-5 w-5 text-amber-500" />
      {lang === "ru" ? "С чего начать" : "Getting Started"}
    </h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {GUIDE_STEPS.map((g) => (
        <div class="flex gap-4 rounded-lg border border-zinc-100 p-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-sm font-bold text-amber-700">
            {g.step}
          </div>
          <div>
            <h3 class="font-semibold text-zinc-800">{lang === "ru" ? g.titleRu : g.titleEn}</h3>
            <p class="mt-1 text-sm text-zinc-500">{lang === "ru" ? g.descRu : g.descEn}</p>
            <a href={localizedPath(g.href, lang)} class="mt-2 inline-block text-sm font-medium text-amber-700 hover:text-amber-600">
              {lang === "ru" ? g.linkRu : g.linkEn}
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="rounded-xl border border-zinc-200 bg-white p-6">
    <h2 class="mb-2 flex items-center gap-2 text-lg font-bold text-slate-800">
      <Icon name="lucide:newspaper" class="h-5 w-5 text-zinc-500" />
      {lang === "ru" ? "Последнее обновление" : "Latest Patch"}
    </h2>
    <div class="space-y-4">
      {(ver.patches ?? []).map((patch) => (
        <div class="rounded-lg bg-zinc-50 p-4">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-700">v{patch.version}</span>
            <span class="text-xs text-zinc-400">{patch.date}</span>
          </div>
          <ul class="mt-2 space-y-1">
            {patch.changes.map((c) => (
              <li class="flex items-start gap-2 text-sm text-zinc-600">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400"></span>
                {lang === "ru" ? c.ru : c.en}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</div>
