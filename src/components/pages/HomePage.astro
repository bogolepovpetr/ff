---
import { Icon } from "astro-icon/components";
import { getGameVersion } from "@/lib/version";
import PatchBadge from "@/components/wiki/PatchBadge.astro";
import { GAME_DISPLAY_NAME, WIKI_DISPLAY_NAME } from "@/lib/site-brand";
import { localizedPath, useT } from "@/lib/i18n";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useT(lang);
const ver = getGameVersion();

const CATEGORIES = [
  { key: "races", iconSrc: "/img/icon/power_troops.svg", title: t("home.category.races.title"), desc: t("home.category.races.desc"), color: "border-orange-300 bg-orange-50 hover:bg-orange-100", iconBg: "bg-orange-200" },
  { key: "buildings", iconSrc: "/img/icon/castle.svg", title: t("home.category.buildings.title"), desc: t("home.category.buildings.desc"), color: "border-blue-300 bg-blue-50 hover:bg-blue-100", iconBg: "bg-blue-200" },
  { key: "troops", iconSrc: "/img/icon/atk.svg", title: t("home.category.troops.title"), desc: t("home.category.troops.desc"), color: "border-red-300 bg-red-50 hover:bg-red-100", iconBg: "bg-red-200" },
  { key: "skills", iconSrc: "/img/icon/skills.svg", title: t("home.category.skills.title"), desc: t("home.category.skills.desc"), color: "border-violet-300 bg-violet-50 hover:bg-violet-100", iconBg: "bg-violet-200" },
  { key: "heroes", iconSrc: "/img/icon/leads.svg", title: t("home.category.heroes.title"), desc: t("home.category.heroes.desc"), color: "border-amber-300 bg-amber-50 hover:bg-amber-100", iconBg: "bg-amber-200" },
  { key: "war", iconSrc: "/img/icon/war.svg", title: t("home.category.war.title"), desc: t("home.category.war.desc"), color: "border-emerald-300 bg-emerald-50 hover:bg-emerald-100", iconBg: "bg-emerald-200" },
  { key: "quests", iconSrc: "/img/icon/quests.svg", title: t("home.category.quests.title"), desc: t("home.category.quests.desc"), color: "border-emerald-300 bg-emerald-50 hover:bg-emerald-100", iconBg: "bg-emerald-200" },
  { key: "clans", iconSrc: "/img/icon/clan.svg", title: t("home.category.clans.title"), desc: t("home.category.clans.desc"), color: "border-zinc-300 bg-zinc-50 hover:bg-zinc-100", iconBg: "bg-zinc-200" },
  { key: "referral", iconSrc: "/img/icon/friends.svg", title: t("home.category.referral.title"), desc: t("home.category.referral.desc"), color: "border-sky-300 bg-sky-50 hover:bg-sky-100", iconBg: "bg-sky-200" },
  { key: "vip", iconSrc: "/img/icon/quests_premium.svg", title: t("home.category.vip.title"), desc: t("home.category.vip.desc"), color: "border-amber-300 bg-amber-50 hover:bg-amber-100", iconBg: "bg-amber-200" },
  { key: "deals", iconSrc: "/img/icon/reward_coin.svg", title: t("home.category.deals.title"), desc: t("home.category.deals.desc"), color: "border-yellow-300 bg-yellow-50 hover:bg-yellow-100", iconBg: "bg-yellow-200" },
  { key: "arena", iconSrc: "/img/icon/rating.svg", title: t("home.category.arena.title"), desc: t("home.category.arena.desc"), color: "border-rose-300 bg-rose-50 hover:bg-rose-100", iconBg: "bg-rose-200" },
  { key: "shop", iconSrc: "/img/icon/shop.svg", title: t("home.category.shop.title"), desc: t("home.category.shop.desc"), color: "border-yellow-300 bg-yellow-50 hover:bg-yellow-100", iconBg: "bg-yellow-200" },
];

const QUICK_LINKS = [
  { href: "/troops/barracks/1", label: t("home.quickLink.barracksTroops"), icon: "🗡️" },
  { href: "/troops/archery_range/1", label: t("home.quickLink.archers"), icon: "🏹" },
  { href: "/troops/stable/1", label: t("home.quickLink.cavalry"), icon: "🐎" },
  { href: "/troops/siege_workshop/1", label: t("home.quickLink.siegeUnits"), icon: "💥" },
  { href: "/skills", label: t("home.quickLink.skillTree"), icon: "🔬" },
  { href: "/heroes", label: t("home.quickLink.allHeroes"), icon: "⚔️" },
];

const GUIDE_STEPS = [
  { step: 1, title: t("home.guideStep.buildings.title"), desc: t("home.guideStep.buildings.desc"), href: "/buildings", link: t("home.guideStep.buildings.link") },
  { step: 2, title: t("home.guideStep.troops.title"), desc: t("home.guideStep.troops.desc"), href: "/troops", link: t("home.guideStep.troops.link") },
  { step: 3, title: t("home.guideStep.skills.title"), desc: t("home.guideStep.skills.desc"), href: "/skills", link: t("home.guideStep.skills.link") },
  { step: 4, title: t("home.guideStep.clans.title"), desc: t("home.guideStep.clans.desc"), href: "/clans", link: t("home.guideStep.clans.link") },
  { step: 5, title: t("home.guideStep.referral.title"), desc: t("home.guideStep.referral.desc"), href: "/referral", link: t("home.guideStep.referral.link") },
  { step: 6, title: t("home.guideStep.war.title"), desc: t("home.guideStep.war.desc"), href: "/war", link: t("home.guideStep.war.link") },
];
---

<div class="space-y-8">
  <section class="overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-emerald-50/90 via-amber-50/80 to-orange-50/70 shadow-sm">
    <div class="flex flex-col items-center gap-6 px-8 py-12 text-center md:flex-row md:text-left">
      <div class="flex-1">
        <h1 class="text-4xl font-extrabold tracking-tight text-foreground">{WIKI_DISPLAY_NAME}</h1>
        <p class="mt-2 text-lg text-primary">
          {t("home.heroSubtitlePrefix")}{GAME_DISPLAY_NAME}
        </p>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">
          {t("home.welcomePrefix")}{lang === "ru" ? GAME_DISPLAY_NAME : WIKI_DISPLAY_NAME}{t("home.welcomeSuffix")}
        </p>
      </div>
      <div class="hidden shrink-0 md:block">
        <img src="/img/_frog/buildings/castle.png" alt={GAME_DISPLAY_NAME} class="h-32 w-32 rounded-2xl object-cover shadow-lg ring-2 ring-primary/20" />
      </div>
    </div>
  </section>

  <PatchBadge gameVersion={ver.gameVersion} dataUpdated={ver.dataUpdated} lang={lang} />

  <section>
    <h2 class="mb-4 text-xl font-bold text-slate-800">{t("home.sectionsTitle")}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORIES.map((cat) => (
        <a
          href={localizedPath(`/${cat.key}`, lang)}
          class={`group flex items-start gap-4 rounded-xl border-2 p-5 transition-all hover:shadow-md hover:-translate-y-0.5 ${cat.color}`}
        >
          <div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl shadow-sm ${cat.iconBg}`}>
            <img src={cat.iconSrc} alt="" class="wiki-section-icon h-7 w-7" />
          </div>
          <div>
            <h3 class="font-bold text-slate-800">{cat.title}</h3>
            <p class="mt-0.5 text-sm text-zinc-600">{cat.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="mb-4 text-xl font-bold text-slate-800">{t("home.quickLinksTitle")}</h2>
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {QUICK_LINKS.map((lnk) => (
        <a
          href={localizedPath(lnk.href, lang)}
          class="flex items-center gap-3 rounded-lg border border-zinc-200 bg-white px-4 py-3 text-sm transition-colors hover:border-amber-300 hover:bg-amber-50"
        >
          <span class="text-lg">{lnk.icon}</span>
          <span class="font-medium text-zinc-700">{lnk.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rounded-xl border border-zinc-200 bg-white p-6">
    <h2 class="mb-4 flex items-center gap-2 text-xl font-bold text-slate-800">
      <Icon name="lucide:trophy" class="h-5 w-5 text-amber-500" />
      {t("home.gettingStartedTitle")}
    </h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {GUIDE_STEPS.map((g) => (
        <div class="flex gap-4 rounded-lg border border-zinc-100 p-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-sm font-bold text-amber-700">
            {g.step}
          </div>
          <div>
            <h3 class="font-semibold text-zinc-800">{g.title}</h3>
            <p class="mt-1 text-sm text-zinc-500">{g.desc}</p>
            <a href={localizedPath(g.href, lang)} class="mt-2 inline-block text-sm font-medium text-amber-700 hover:text-amber-600">
              {g.link}
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="rounded-xl border border-zinc-200 bg-white p-6">
    <h2 class="mb-2 flex items-center gap-2 text-lg font-bold text-slate-800">
      <Icon name="lucide:newspaper" class="h-5 w-5 text-zinc-500" />
      {t("home.latestPatchTitle")}
    </h2>
    <div class="space-y-4">
      {(ver.patches ?? []).map((patch) => (
        <div class="rounded-lg bg-zinc-50 p-4">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-700">v{patch.version}</span>
            <span class="text-xs text-zinc-400">{patch.date}</span>
          </div>
          <ul class="mt-2 space-y-1">
            {patch.changes.map((c) => (
              <li class="flex items-start gap-2 text-sm text-zinc-600">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400"></span>
                {lang === "ru" ? c.ru : c.en}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</div>
