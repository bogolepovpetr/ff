---
import { Icon } from "astro-icon/components";
import { getVipPassLevels, getVipWiki } from "@/lib/data";
import { formatCost } from "@/lib/format";
import WikiBreadcrumbs from "@/components/wiki/WikiBreadcrumbs.astro";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const ru = lang === "ru";
const wiki = getVipWiki();
const levels = getVipPassLevels();
const maxLevel = Math.max(...levels.map((l) => l.lvl));
---

<div class="space-y-6">
  <WikiBreadcrumbs
    crumbs={[
      { href: localizedPath("/", lang), label: ru ? "Главная" : "Home" },
      { href: localizedPath("/deals", lang), label: "Deals" },
      { label: "VIP" },
    ]}
  />

  <div class="wiki-hero">
    <h1 class="flex items-center gap-2 text-2xl font-bold">
      <Icon name="lucide:crown" class="h-6 w-6 text-[var(--game-orange)]" />
      VIP
    </h1>
    <p class="mt-2 text-sm leading-relaxed opacity-90">{ru ? wiki.intro_ru : wiki.intro_en}</p>
    <ul class="mt-4 space-y-1.5 text-sm opacity-90">
      {(ru ? wiki.bullets_ru : wiki.bullets_en).map((b) => (
        <li class="flex gap-2">
          <span class="text-[var(--game-orange)]">•</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>
    <div class="mt-4">
      <span class="wiki-chip wiki-chip-accent">
        <Icon name="lucide:crown" class="h-3.5 w-3.5" />
        {ru ? "Макс. уровень" : "Max level"}: {maxLevel}
      </span>
    </div>
  </div>

  <section class="grid gap-3 sm:grid-cols-3">
    <a href={localizedPath("/deals/vip/levels", lang)} class="group wiki-panel p-4 transition-all hover:-translate-y-0.5 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--game-orange)_18%,white)] text-[var(--game-orange)]">
          <Icon name="lucide:trophy" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold">{ru ? "VIP-уровни" : "VIP levels"}</p>
          <p class="mt-0.5 text-xs text-muted-foreground">{ru ? "Новые пассивные бонусы" : "New passive bonuses"}</p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-muted-foreground group-hover:text-[var(--game-orange)]" />
      </div>
    </a>

    <a href={localizedPath("/deals/vip/time", lang)} class="group wiki-panel p-4 transition-all hover:-translate-y-0.5 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--game-green)_18%,white)] text-[var(--game-green)]">
          <Icon name="lucide:clock" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold">{ru ? "VIP-время" : "VIP time"}</p>
          <p class="mt-0.5 text-xs text-muted-foreground">{ru ? "Покупка за гемы" : "Purchase with gems"}</p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-muted-foreground group-hover:text-[var(--game-green)]" />
      </div>
    </a>

    <a href={localizedPath("/deals/vip/streak", lang)} class="group wiki-panel p-4 transition-all hover:-translate-y-0.5 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--game-atk)_18%,white)] text-[var(--game-atk)]">
          <Icon name="lucide:flame" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold">{ru ? "Стрик сундука" : "Chest streak"}</p>
          <p class="mt-0.5 text-xs text-muted-foreground">{ru ? "28 дней входа" : "28-day login streak"}</p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-muted-foreground group-hover:text-[var(--game-atk)]" />
      </div>
    </a>
  </section>

  <section class="wiki-panel">
    <div class="flex items-center justify-between border-b border-[var(--game-frame)] px-5 py-3">
      <h2 class="text-lg font-bold">{ru ? "VIP-уровни (кратко)" : "VIP levels (quick view)"}</h2>
      <a href={localizedPath("/deals/vip/levels", lang)} class="wiki-link text-sm font-semibold">
        {ru ? "Полная таблица" : "Full table"}
      </a>
    </div>
    <div class="overflow-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-[var(--game-frame)] bg-[var(--game-bg)] text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
            <th class="px-4 py-2">{ru ? "Уровень" : "Level"}</th>
            <th class="px-4 py-2">{ru ? "VIP-очки" : "VIP points"}</th>
          </tr>
        </thead>
        <tbody>
          {levels.filter((l) => l.lvl > 0).slice(0, 8).map((l, i) => (
            <tr class={`border-b border-[var(--game-frame)]/50 ${i % 2 === 1 ? "bg-[var(--game-bg)]/40" : ""}`}>
              <td class="px-4 py-2 font-semibold">{l.title}</td>
              <td class="px-4 py-2">{formatCost(l.gem_cost)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>
