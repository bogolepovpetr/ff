---
import { Icon } from "astro-icon/components";
import { getBuildings, indexByKey } from "@/lib/data";
import { getManualDoc } from "@/lib/manual";
import { formatCost, formatTime } from "@/lib/format";
import { getGameVersion } from "@/lib/version";
import { buildingImage } from "@/lib/images";
import PatchBadge from "@/components/wiki/PatchBadge.astro";
import ResourceIcon, { type ResourceKey } from "@/components/wiki/ResourceIcon.astro";
import { localizedPath, useT } from "@/lib/i18n";

interface Props {
  lang: string;
  buildingKey: string;
}

const { lang, buildingKey } = Astro.props;
const t = useT(lang);
const building = indexByKey(getBuildings()).get(buildingKey)!;
const manual = getManualDoc({ lang, entity: "buildings", key: buildingKey });

const effectKeys = new Set<string>();
for (const lvl of building.levels) {
  for (const k of Object.keys(lvl)) {
    if (k.startsWith("bonus") && !["bonus", "bonusRate", "bonusValue"].includes(k)) {
      effectKeys.add(k);
    }
  }
}
const effectCols = Array.from(effectKeys).sort();

const allBuildings = getBuildings();
const buildingNameMap = new Map<string, string>();
for (const b of allBuildings) buildingNameMap.set(b.key, b.title);

const ver = getGameVersion();

function humanizeBonus(key: string): string {
  return key.replace(/^bonus/, "").replace(/([A-Z])/g, " $1").trim();
}

type CostParts = { res: ResourceKey; val: string }[];
function costParts(food?: number, wood?: number, stone?: number, gem?: number): CostParts {
  const parts: CostParts = [];
  if (food) parts.push({ res: "food", val: formatCost(food) });
  if (wood) parts.push({ res: "wood", val: formatCost(wood) });
  if (stone) parts.push({ res: "stone", val: formatCost(stone) });
  if (gem) parts.push({ res: "gem", val: formatCost(gem) });
  return parts;
}
---

<div class="space-y-6">
  <nav class="flex items-center gap-1 text-sm text-zinc-500">
    <a href={localizedPath("/buildings", lang)} class="hover:text-amber-700 hover:underline">
      {t("buildingDetail.breadcrumbBuildings")}
    </a>
    <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
    <span class="font-medium text-zinc-700">{building.title}</span>
  </nav>

  <div class="flex flex-col gap-5 md:flex-row">
    <div class="flex-1 space-y-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">{building.title}</h1>
        {building.type ? (
          <span class="mt-1 inline-block rounded-full bg-amber-100 px-3 py-0.5 text-xs font-semibold text-amber-800">{building.type}</span>
        ) : null}
      </div>

      {manual ? (
        <div class="prose prose-zinc max-w-none rounded-xl border border-zinc-200 bg-white p-5" set:html={manual.html} />
      ) : null}
    </div>

    <div class="w-full shrink-0 md:w-64">
      <div class="rounded-xl border border-zinc-200 bg-white">
        <div class="flex justify-center border-b border-zinc-100 p-4">
          <img src={buildingImage(building.key)} alt={building.title} class="h-56 w-56 shrink-0 rounded-lg object-cover" />
        </div>
        <div class="space-y-2 p-4 text-sm">
          <div class="flex justify-between">
            <span class="text-zinc-500">{t("buildingDetail.statType")}</span>
            <span class="font-medium text-zinc-800">{building.type ?? "—"}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-500">{t("buildingDetail.statLevels")}</span>
            <span class="font-medium text-zinc-800">{building.levels.length}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-500">{t("buildingDetail.statMaxPower")}</span>
            <span class="font-medium text-zinc-800">
              {building.levels.length ? String(building.levels[building.levels.length - 1].power ?? "—") : "—"}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <PatchBadge gameVersion={ver.gameVersion} dataUpdated={ver.dataUpdated} lang={lang} />

  <section class="rounded-xl border border-zinc-200 bg-white">
    <div class="border-b border-zinc-100 px-5 py-3">
      <h2 class="text-lg font-bold text-slate-800">{t("buildingDetail.progressionTitle")}</h2>
      <p class="text-xs text-zinc-400">
        {t("buildingDetail.progressionNote")}
      </p>
    </div>
    <div class="overflow-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wider text-zinc-500">
            <th class="px-4 py-2.5">{t("buildingDetail.tableLevel")}</th>
            <th class="px-4 py-2.5">{t("buildingDetail.tableCost")}</th>
            <th class="px-4 py-2.5">{t("buildingDetail.tableTime")}</th>
            <th class="px-4 py-2.5">{t("buildingDetail.tablePower")}</th>
            {effectCols.map((k) => <th class="px-4 py-2.5">{humanizeBonus(k)}</th>)}
            <th class="px-4 py-2.5">{t("buildingDetail.tableRequirements")}</th>
          </tr>
        </thead>
        <tbody>
          {building.levels.map((lvl: any, i: number) => {
            const parts = costParts(lvl.priceFood, lvl.priceWood, lvl.priceStone, lvl.priceGem);
            const reqs = lvl.requiredBuildings ? Object.entries(lvl.requiredBuildings) as [string, number][] : [];
            return (
              <tr class={`border-b border-zinc-100 align-top ${i % 2 === 1 ? "bg-zinc-50/50" : ""}`}>
                <td class="px-4 py-2 font-bold text-amber-700">{lvl.level}</td>
                <td class="px-4 py-2">
                  {parts.length === 0 ? (
                    <span class="text-zinc-400">—</span>
                  ) : (
                    <div class="flex flex-col gap-0.5">
                      {parts.map((p) => (
                        <span class="inline-flex items-center gap-0.5 whitespace-nowrap">
                          <ResourceIcon res={p.res} class="h-4 w-4 text-sky-600" />
                          {p.val}
                        </span>
                      ))}
                    </div>
                  )}
                </td>
                <td class="px-4 py-2 text-zinc-700">{formatTime(lvl.time)}</td>
                <td class="px-4 py-2 font-medium">{lvl.power ?? "—"}</td>
                {effectCols.map((k) => (
                  <td class="px-4 py-2 text-zinc-700">
                    {typeof lvl[k] === "number" ? (lvl[k] as number).toLocaleString("en-US") : String(lvl[k] ?? "—")}
                  </td>
                ))}
                <td class="px-4 py-2 text-zinc-600">
                  {reqs.length > 0 ? (
                    reqs.map(([bk, bv], ri) => (
                      <span>
                        <a href={localizedPath(`/buildings/${bk}`, lang)} class="text-amber-700 underline decoration-amber-300 hover:text-amber-600">
                          {buildingNameMap.get(bk) ?? bk}
                        </a>
                        {" Lv."}{bv}{ri < reqs.length - 1 ? ", " : ""}
                      </span>
                    ))
                  ) : (
                    "—"
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
</div>
