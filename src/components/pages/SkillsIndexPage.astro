---
import { getSkillTreeData } from "@/lib/data";
import { getLore } from "@/lib/lore";
import SkillTree from "@/components/wiki/SkillTree.vue";

interface Props { lang: string }
const { lang } = Astro.props;
const lore = getLore("skills", lang);
const trees = getSkillTreeData();

const categoryLabels = [
  { key: "Economic", label: lang === "ru" ? "Экономический" : "Economic" },
  { key: "Military", label: lang === "ru" ? "Боевые действия" : "Military" },
].filter((c) => trees[c.key]);
---

<div class="space-y-6">
  <div class="rounded-xl border border-amber-200 bg-gradient-to-r from-amber-50 to-violet-50 p-6">
    <h1 class="text-2xl font-bold text-slate-900">{lore.title}</h1>
    <p class="mt-1 text-sm font-medium text-amber-700">{lore.subtitle}</p>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-600">{lore.intro}</p>
  </div>

  <SkillTree trees={trees} lang={lang} categoryLabels={categoryLabels} client:idle />
</div>
