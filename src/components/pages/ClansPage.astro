---
import { Icon } from "astro-icon/components";
import { getClanLevels, getClanRanks, getClanRewards } from "@/lib/data";
import RewardBits from "@/components/wiki/RewardBits.astro";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const ru = lang === "ru";

function fmtNumber(n: number): string {
  return new Intl.NumberFormat("en-US").format(n);
}

function fmtRewardTitle(title: string, hours: number): string {
  const base = ru ? "Награда каждые {count} часов" : "Reward every {count} hours";
  const tpl = title?.includes("{count}") ? title : base;
  return tpl.replaceAll("{count}", String(hours));
}

function rankTitle(title: string): string {
  if (!ru) return title;
  const map: Record<string, string> = {
    Founder: "Основатель",
    Deputy: "Заместитель",
    Officer: "Офицер",
    Soldier: "Солдат",
    Recruit: "Рекрут",
    Newbie: "Новичок",
  };
  return map[title] ?? title;
}

const levels = getClanLevels();
const ranks = getClanRanks();
const rewards = getClanRewards().slice().sort((a, b) => a.level - b.level);

const maxLevel = Math.max(0, ...levels.map((x) => x.level), ...rewards.map((x) => x.level));
const maxMembers = Math.max(0, ...levels.map((x) => x.members));
---

<div class="space-y-6">
  <div class="wiki-hero p-6">
    <h1 class="text-2xl font-bold text-slate-900">{ru ? "Кланы" : "Clans"}</h1>
    <p class="mt-2 text-sm leading-relaxed text-zinc-600">
      {ru
        ? "Уровень клана открывает награды, а ранги определяют роли участников. Здесь собраны таблицы уровней, рангов и клановых наград."
        : "Clan level unlocks rewards, and ranks define member roles. Here are the tables for clan levels, ranks, and clan rewards."}
    </p>

    <div class="mt-4 flex flex-wrap gap-3 text-xs">
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-emerald-700">
        <Icon name="lucide:crown" class="h-3.5 w-3.5" />
        {ru ? "Макс. уровень" : "Max level"}: <span class="font-semibold">{maxLevel}</span>
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-emerald-700">
        <Icon name="lucide:users" class="h-3.5 w-3.5" />
        {ru ? "Макс. участников" : "Max members"}: <span class="font-semibold">{maxMembers}</span>
      </span>
    </div>
  </div>

  <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <a href={localizedPath("/clans/levels", lang)} class="group rounded-xl border border-zinc-200 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-amber-700">
          <Icon name="lucide:trophy" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold text-zinc-800">{ru ? "Уровни клана" : "Clan Levels"}</p>
          <p class="mt-0.5 text-xs text-zinc-500">{ru ? "Опыт и лимит участников" : "Exp and member cap"}</p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-zinc-300 group-hover:text-amber-500" />
      </div>
    </a>

    <a href={localizedPath("/clans/rewards", lang)} class="group rounded-xl border border-zinc-200 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
          <Icon name="lucide:gift" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold text-zinc-800">{ru ? "Награды клана" : "Clan Rewards"}</p>
          <p class="mt-0.5 text-xs text-zinc-500">{ru ? "Интервалы и состав награды" : "Intervals and rewards"}</p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-zinc-300 group-hover:text-emerald-600" />
      </div>
    </a>

    <a href={localizedPath("/clans/ranks", lang)} class="group rounded-xl border border-zinc-200 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-100 text-sky-700">
          <Icon name="lucide:users" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold text-zinc-800">{ru ? "Ранги" : "Ranks"}</p>
          <p class="mt-0.5 text-xs text-zinc-500">{ru ? "Пороги очков клана" : "Clan points thresholds"}</p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-zinc-300 group-hover:text-sky-600" />
      </div>
    </a>

    <a href={localizedPath("/clans/war", lang)} class="group rounded-xl border border-zinc-200 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-100 text-rose-700">
          <Icon name="lucide:trophy" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold text-zinc-800">{ru ? "Клановая война" : "Clan War"}</p>
          <p class="mt-0.5 text-xs text-zinc-500">{ru ? "Правила, награды, потери" : "Rules, rewards, losses"}</p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-zinc-300 group-hover:text-rose-600" />
      </div>
    </a>
  </section>

  <section class="rounded-xl border border-zinc-200 bg-white">
    <div class="flex items-center justify-between border-b border-zinc-100 px-5 py-3">
      <h2 class="text-lg font-bold text-slate-800">{ru ? "Клановые награды (быстро)" : "Clan rewards (quick view)"}</h2>
      <a href={localizedPath("/clans/rewards", lang)} class="text-sm font-semibold text-amber-700 hover:text-amber-600">
        {ru ? "Открыть таблицу" : "Open table"}
      </a>
    </div>
    <div class="divide-y divide-zinc-50">
      {rewards.slice(0, 6).map((r) => (
        <div class="flex items-center gap-4 px-5 py-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200">
            <Icon name="lucide:gift" class="h-4 w-4" />
          </div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-zinc-800">{fmtRewardTitle(r.title, r.hours)}</p>
            <p class="mt-0.5 text-xs text-zinc-500">
              {ru ? "Доступно с уровня" : "Available from level"} <span class="font-semibold">Lv {r.level}</span>
            </p>
          </div>
          <RewardBits food={r.food} wood={r.wood} stone={r.stone} gem={r.gem} />
        </div>
      ))}
    </div>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-zinc-200 bg-white">
      <div class="border-b border-zinc-100 px-5 py-3">
        <h2 class="text-lg font-bold text-slate-800">{ru ? "Уровни клана" : "Clan levels"}</h2>
        <p class="mt-1 text-xs text-zinc-500">
          {ru ? "Опыт — порог суммарных очков/вклада для достижения уровня." : "Exp is the total threshold to reach the level."}
        </p>
      </div>
      <div class="overflow-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wider text-zinc-500">
              <th class="px-4 py-2">{ru ? "Уровень" : "Level"}</th>
              <th class="px-4 py-2">{ru ? "Опыт" : "Exp"}</th>
              <th class="px-4 py-2">{ru ? "Участников" : "Members"}</th>
            </tr>
          </thead>
          <tbody>
            {levels.map((l, i) => (
              <tr class={`border-b border-zinc-100 ${i % 2 === 1 ? "bg-zinc-50/50" : ""}`}>
                <td class="px-4 py-2 font-semibold text-zinc-800">Lv {l.level}</td>
                <td class="px-4 py-2 text-zinc-700">{fmtNumber(l.exp)}</td>
                <td class="px-4 py-2 text-zinc-700">{fmtNumber(l.members)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded-xl border border-zinc-200 bg-white">
      <div class="border-b border-zinc-100 px-5 py-3">
        <h2 class="text-lg font-bold text-slate-800">{ru ? "Ранги (по очкам клана)" : "Ranks (by clan points)"}</h2>
        <p class="mt-1 text-xs text-zinc-500">
          {ru ? "Порог — минимальные очки клана для ранга." : "Threshold is the minimum clan points for the rank."}
        </p>
      </div>
      <div class="overflow-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wider text-zinc-500">
              <th class="px-4 py-2">{ru ? "Ранг" : "Rank"}</th>
              <th class="px-4 py-2">{ru ? "Порог" : "Threshold"}</th>
            </tr>
          </thead>
          <tbody>
            {ranks.map((r, i) => (
              <tr class={`border-b border-zinc-100 ${i % 2 === 1 ? "bg-zinc-50/50" : ""}`}>
                <td class="px-4 py-2 font-semibold text-zinc-800">{rankTitle(r.title)}</td>
                <td class="px-4 py-2 text-zinc-700">{r.isOwner || r.isDeputy ? "—" : fmtNumber(r.points)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
