---
import { getBuildings } from "@/lib/data";
import { getLore } from "@/lib/lore";
import { buildingImage } from "@/lib/images";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const lore = getLore("buildings", lang);
const buildings = getBuildings().slice().sort((a, b) => a.title.localeCompare(b.title));

const groups = new Map<string, typeof buildings>();
for (const b of buildings) {
  const k = b.type || "Other";
  const list = groups.get(k) ?? [];
  list.push(b);
  groups.set(k, list);
}
---

<div class="space-y-6">
  <div class="rounded-xl border border-amber-200 bg-gradient-to-r from-amber-50 to-orange-50 p-6">
    <h1 class="text-2xl font-bold text-slate-900">{lore.title}</h1>
    <p class="mt-1 text-sm font-medium text-amber-700">{lore.subtitle}</p>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-600">{lore.intro}</p>
  </div>

  {Array.from(groups.entries()).map(([type, items]) => (
    <section>
      <h2 class="mb-3 flex items-center gap-2 text-lg font-bold text-slate-800">
        <span class="h-1 w-4 rounded-full bg-amber-400"></span>
        {type}
        <span class="text-sm font-normal text-zinc-400">({items.length})</span>
      </h2>
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        {items.map((b) => (
          <a
            href={localizedPath(`/buildings/${b.key}`, lang)}
            class="group flex items-center gap-3 rounded-lg border border-zinc-200 bg-white p-3 transition-all hover:border-amber-300 hover:shadow-md"
          >
            <img src={buildingImage(b.key)} alt={b.title} class="h-14 w-14 shrink-0 rounded-lg object-cover" />
            <div class="min-w-0 flex-1">
              <p class="truncate font-semibold text-zinc-800 transition-colors group-hover:text-amber-700">{b.title}</p>
              {b.desc && <p class="mt-0.5 truncate text-xs text-zinc-500">{b.desc}</p>}
              <p class="mt-0.5 text-xs text-zinc-400">{b.levels.length} levels</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</div>
