---
import { Icon } from "astro-icon/components";
import { getVipPassLevels } from "@/lib/data";
import { extractVipNewPerms, extractVipNewUnlocks, formatCost } from "@/lib/format";
import WikiBreadcrumbs from "@/components/wiki/WikiBreadcrumbs.astro";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const ru = lang === "ru";
const allLevels = getVipPassLevels();
const levels = allLevels.filter((l) => l.lvl > 0);
---

<div class="space-y-6">
  <WikiBreadcrumbs
    crumbs={[
      { href: localizedPath("/", lang), label: ru ? "Главная" : "Home" },
      { href: localizedPath("/deals", lang), label: "Deals" },
      { href: localizedPath("/deals/vip", lang), label: "VIP" },
      { label: ru ? "VIP-уровни" : "VIP levels" },
    ]}
  />

  <section class="wiki-panel">
    <div class="border-b border-[var(--game-frame)] px-5 py-4">
      <h1 class="flex items-center gap-2 text-2xl font-bold">
        <Icon name="lucide:crown" class="h-6 w-6 text-[var(--game-orange)]" />
        {ru ? "VIP-уровни" : "VIP levels"}
      </h1>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        {ru
          ? "На каждом уровне показаны новые пассивные бонусы и разблокировки. Итоговые значения бонусов — абсолютные для текущего уровня."
          : "Each level shows newly unlocked passive bonuses and features. Total bonus values are absolute for that level."}
      </p>
    </div>

    <div class="overflow-auto">
      <table class="w-full min-w-[800px] text-sm">
        <thead>
          <tr class="border-b border-[var(--game-frame)] bg-[var(--game-bg)] text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
            <th class="px-4 py-2">{ru ? "Уровень" : "Level"}</th>
            <th class="px-4 py-2">{ru ? "VIP-очки" : "VIP points"}</th>
            <th class="px-4 py-2">{ru ? "Новые пассивные бонусы" : "New passive bonuses"}</th>
            <th class="px-4 py-2">{ru ? "Разблокировки" : "Unlocks"}</th>
          </tr>
        </thead>
        <tbody>
          {levels.map((l, i) => {
            const prev = allLevels.find((x) => x.lvl === l.lvl - 1) ?? null;
            const unlocks = extractVipNewUnlocks(l, prev, lang);
            const perms = extractVipNewPerms(l, prev, lang);
            const skinNew =
              l.skinKey && l.skinKey !== (prev as { skinKey?: string } | null)?.skinKey
                ? [ru ? "VIP-скин города" : "VIP city skin"]
                : [];
            const allPerms = [...perms, ...skinNew];

            return (
              <tr class={`border-b border-[var(--game-frame)]/50 align-top ${i % 2 === 1 ? "bg-[var(--game-bg)]/40" : ""}`}>
                <td class="px-4 py-3 font-semibold">{l.title}</td>
                <td class="px-4 py-3">{formatCost(l.gem_cost)}</td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1.5">
                    {unlocks.length === 0 ? (
                      <span class="text-muted-foreground">—</span>
                    ) : (
                      unlocks.map((u) => (
                        <span class={u.kind === "new" ? "wiki-unlock-new" : "wiki-unlock-up"}>
                          {u.kind === "new" ? "+" : "↑"} {u.label}
                          {u.kind === "upgrade" && u.prevValue !== undefined ? `: ${u.prevValue} → ${u.value}` : `: ${u.value}`}
                        </span>
                      ))
                    )}
                  </div>
                </td>
                <td class="px-4 py-3 text-xs">
                  {allPerms.length === 0 ? (
                    <span class="text-muted-foreground">—</span>
                  ) : (
                    <div class="flex flex-wrap gap-1">
                      {allPerms.map((p) => (
                        <span class="wiki-unlock-new">+ {p}</span>
                      ))}
                    </div>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
</div>
