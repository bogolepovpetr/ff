---
import { Icon } from "astro-icon/components";
import { getReferralData } from "@/lib/data";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const ru = lang === "ru";
const data = getReferralData();
const rev = data.revshare;

function fmtNumber(n: number): string {
  return new Intl.NumberFormat("en-US").format(n);
}
---

<div class="space-y-6">
  <nav class="flex items-center gap-1 text-sm text-zinc-500">
    <a href={localizedPath("/", lang)} class="hover:text-amber-700 hover:underline">{ru ? "Главная" : "Home"}</a>
    <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
    <a href={localizedPath("/referral", lang)} class="hover:text-amber-700 hover:underline">{ru ? "Рефералы" : "Referral"}</a>
    <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" />
    <span class="font-medium text-zinc-700">{ru ? "Rev share (USDT)" : "Rev share (USDT)"}</span>
  </nav>

  <div class="rounded-xl border border-sky-200 bg-sky-50 p-6">
    <div class="flex items-start gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-sky-700 shadow-sm">
        <Icon name="lucide:percent" class="h-5 w-5" />
      </div>
      <div class="min-w-0">
        <h1 class="text-2xl font-bold text-slate-900">{ru ? "Rev share" : "Revenue share"}</h1>
        <p class="mt-2 text-sm text-zinc-700">
          {ru ? "Вы получаете" : "You receive"}{" "}
          <span class="font-semibold text-zinc-900">{rev.share_percent}%</span>{" "}
          {ru ? "за каждую покупку, совершенную вашими друзьями." : "from each purchase made by your friends."}
        </p>
      </div>
    </div>
  </div>

  <section class="grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-zinc-200 bg-white p-5">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
          <Icon name="lucide:wallet" class="h-5 w-5" />
        </div>
        <h2 class="text-lg font-bold text-slate-800">{ru ? "Вариант 1: Вывести реальные USDT" : "Option 1: Withdraw real USDT"}</h2>
      </div>
      <p class="mt-3 text-sm text-zinc-700">{ru ? rev.withdraw.note_ru : rev.withdraw.note_en}</p>
      <div class="mt-3 rounded-lg border border-zinc-200 bg-zinc-50 p-3 text-sm text-zinc-700">
        <p>
          <span class="font-semibold">{ru ? "Минимальная сумма" : "Minimum"}</span>: {fmtNumber(rev.withdraw.min_usdt)} USDT
        </p>
        <p class="mt-1">
          <span class="font-semibold">{ru ? "Контакт поддержки" : "Support"}</span>: {rev.withdraw.support_contact}
        </p>
      </div>
    </div>

    <div class="rounded-xl border border-zinc-200 bg-white p-5">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-amber-800">
          <Icon name="lucide:gamepad-2" class="h-5 w-5" />
        </div>
        <h2 class="text-lg font-bold text-slate-800">{ru ? "Вариант 2: Конвертировать в игровую USDT" : "Option 2: Convert to in-game USDT"}</h2>
      </div>
      <p class="mt-3 text-sm text-zinc-700">{ru ? rev.convert.note_ru : rev.convert.note_en}</p>
      <div class="mt-3 rounded-lg border border-zinc-200 bg-zinc-50 p-3 text-sm text-zinc-700">
        <p>
          <span class="font-semibold">{ru ? "Минимум" : "Minimum"}</span>: {fmtNumber(rev.convert.min_stars)} {ru ? "звёзд" : "Stars"}
        </p>
      </div>
    </div>
  </section>

  <section class="rounded-xl border border-zinc-200 bg-white p-5">
    <h2 class="text-lg font-bold text-slate-800">{ru ? "Что это значит на практике" : "What this means"}</h2>
    <ul class="mt-2 list-disc space-y-2 pl-5 text-sm text-zinc-700">
      <li>
        {ru
          ? "Rev share начисляется от покупок ваших приглашённых друзей."
          : "Rev share is credited from purchases of your invited friends."}
      </li>
      <li>
        {ru
          ? "Доступно два пути: вывести реальные USDT или конвертировать в внутриигровой USDT-баланс."
          : "Two paths: withdraw real USDT or convert to in-game USDT balance."}
      </li>
      <li>
        {ru
          ? "Для вывода есть минимальная сумма и обращение в поддержку."
          : "Withdrawals have a minimum amount and require contacting support."}
      </li>
    </ul>
    <div class="mt-4 inline-flex items-center gap-2 rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-800">
      <Icon name="lucide:arrow-right-left" class="h-4 w-4" />
      {ru ? "Доля: " : "Share: "}{rev.share_percent}%
    </div>
  </section>
</div>
