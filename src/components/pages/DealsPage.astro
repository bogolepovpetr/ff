---
import { Icon } from "astro-icon/components";
import { getDawnFundTopup, getVipPassLevels } from "@/lib/data";
import WikiBreadcrumbs from "@/components/wiki/WikiBreadcrumbs.astro";
import { localizedPath } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const ru = lang === "ru";
const maxVip = Math.max(...getVipPassLevels().map((l) => l.lvl));
const topup = getDawnFundTopup();
---

<div class="space-y-6">
  <WikiBreadcrumbs
    crumbs={[
      { href: localizedPath("/", lang), label: ru ? "Главная" : "Home" },
      { label: "Deals" },
    ]}
  />

  <div class="wiki-hero">
    <h1 class="flex items-center gap-2 text-2xl font-bold">
      <Icon name="lucide:sparkles" class="h-6 w-6 text-[var(--game-orange)]" />
      Deals
    </h1>
    <p class="mt-2 text-sm leading-relaxed opacity-90">
      {ru
        ? "Премиум-предложения: VIP-привилегии и Fund of Dawn — награды за прогресс замка."
        : "Premium offers: VIP perks and Fund of Dawn — rewards tied to Castle progress."}
    </p>
  </div>

  <section class="grid gap-3 sm:grid-cols-2">
    <a href={localizedPath("/deals/vip", lang)} class="group wiki-panel p-4 transition-all hover:-translate-y-0.5 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--game-orange)_18%,white)] text-[var(--game-orange)]">
          <Icon name="lucide:crown" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold">VIP</p>
          <p class="mt-0.5 text-xs text-muted-foreground">
            {ru ? `Уровни 1–${maxVip}, VIP-время, стрик сундука` : `Levels 1–${maxVip}, VIP time, chest streak`}
          </p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-muted-foreground group-hover:text-[var(--game-orange)]" />
      </div>
    </a>

    <a href={localizedPath("/deals/dawn-fund", lang)} class="group wiki-panel p-4 transition-all hover:-translate-y-0.5 hover:shadow-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--game-green)_18%,white)] text-[var(--game-green)]">
          <Icon name="lucide:castle" class="h-5 w-5" />
        </div>
        <div class="min-w-0">
          <p class="font-bold">{ru ? "Фонд Рассвета" : "Fund of Dawn"}</p>
          <p class="mt-0.5 text-xs text-muted-foreground">
            {ru ? `От ${topup.priceStar} ⭐ · награды за уровень замка` : `From ${topup.priceStar} ⭐ · rewards per Castle level`}
          </p>
        </div>
        <Icon name="lucide:arrow-right" class="ml-auto h-4 w-4 text-muted-foreground group-hover:text-[var(--game-green)]" />
      </div>
    </a>
  </section>
</div>
