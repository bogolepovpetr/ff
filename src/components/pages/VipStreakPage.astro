---
import { Icon } from "astro-icon/components";
import { getVipStreak } from "@/lib/data";
import WikiBreadcrumbs from "@/components/wiki/WikiBreadcrumbs.astro";
import { localizedPath, useT } from "@/lib/i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const t = useT(lang);
const streak = getVipStreak();

function fmtNumber(n: number): string {
  return new Intl.NumberFormat("en-US").format(n);
}
---

<div class="space-y-6">
  <WikiBreadcrumbs
    crumbs={[
      { href: localizedPath("/", lang), label: t("common.home") },
      { href: localizedPath("/vip", lang), label: "VIP" },
      { label: t("vipStreak.breadcrumbChestStreak") },
    ]}
  />

  <section class="wiki-panel">
    <div class="border-b border-[var(--game-frame)] px-5 py-4">
      <h1 class="flex items-center gap-2 text-2xl font-bold">
        <Icon name="lucide:flame" class="h-6 w-6 text-[var(--game-atk)]" />
        {t("vipStreak.title")}
      </h1>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        {t("vipStreak.description")}
      </p>
    </div>

    <div class="overflow-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-[var(--game-frame)] bg-[var(--game-bg)] text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground">
            <th class="px-4 py-2">{t("vipStreak.tableDay")}</th>
            <th class="px-4 py-2">{t("vipStreak.tableVipPoints")}</th>
          </tr>
        </thead>
        <tbody>
          {streak.map((s, i) => (
            <tr class={`border-b border-[var(--game-frame)]/50 ${i % 2 === 1 ? "bg-[var(--game-bg)]/40" : ""}`}>
              <td class="px-4 py-2 font-semibold">{s.key}</td>
              <td class="px-4 py-2">{fmtNumber(s.points)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</div>
